diff --git a/src/video/ps4/SDL_ps4piglet.c b/src/video/ps4/SDL_ps4piglet.c
index 0545613..6ac1e72 100644
--- a/src/video/ps4/SDL_ps4piglet.c
+++ b/src/video/ps4/SDL_ps4piglet.c
@@ -12,6 +12,7 @@
 #include "../../SDL_internal.h"
 #include "SDL_hints.h"
 #include "SDL_error.h"
+#include "SDL_egl.h"
 #include "SDL_ps4piglet.h"
 
 #define PIGLET_MODULE_NAME "libScePigletv2VSH.sprx"
@@ -177,20 +178,64 @@ int PS4_PigletInit() {
         }
     }
 
-    SDL_memset(&ps4_pgl_config, 0, sizeof(ps4_pgl_config));
-    ps4_pgl_config.size = sizeof(ps4_pgl_config);
-    ps4_pgl_config.flags = 0;
-    ps4_pgl_config.systemSharedMemorySize = 256 * 1024 * 1024;
-    ps4_pgl_config.videoSharedMemorySize = 256 * 1024 * 1024;
-    ps4_pgl_config.drawCommandBufferSize = 1 * 1024 * 1024;
-    ps4_pgl_config.lcueResourceBufferSize = 1 * 1024 * 1024;
-    ps4_pgl_config.dbgPosCmd_0x40 = 1920;
-    ps4_pgl_config.dbgPosCmd_0x44 = 1080;
-    ps4_pgl_config.unk_0x5C = 2;
-
-    if (!scePigletSetConfigurationVSH(&ps4_pgl_config)) {
-        SDL_Log("PS4_PigletInit: scePigletSetConfigurationVSH failed\n");
-        return 1;
+    /* Try Piglet memory configs in order until eglGetDisplay() succeeds.
+     * A single fixed config (system 256 MiB / video 256 MiB, no flexible
+     * memory) does not yield an EGL display on every run: the LibreSprite
+     * smoke test failed SDL_CreateWindow with "Could not get EGL display"
+     * on console while Solarus' gl-smoke passed with the same SDL build.
+     * SoH's Ps4Platform.cpp proves eglGetDisplay() is config-sensitive
+     * and retries configs until one works; mirror its candidate list
+     * (first entry: system 128 / video 512 / flexible 236 MiB). */
+    {
+        static const struct {
+            uint64_t systemShared;
+            uint64_t videoShared;
+            uint64_t flexible;
+            uint32_t drawCommandBuffer;
+            uint32_t lcueResourceBuffer;
+        } candidates[] = {
+            { 128ull << 20, 512ull << 20, 236ull << 20, 4u << 20, 4u << 20 },
+            { 128ull << 20, 512ull << 20, 208ull << 20, 4u << 20, 4u << 20 },
+            { 128ull << 20, 512ull << 20, 208ull << 20, 1u << 20, 1u << 20 },
+            { 64ull << 20, 128ull << 20, 208ull << 20, 1u << 20, 1u << 20 },
+            { 64ull << 20, 128ull << 20, 176ull << 20, 1u << 20, 1u << 20 },
+            { 64ull << 20, 128ull << 20, 64ull << 20, 1u << 20, 1u << 20 },
+        };
+        size_t i;
+        EGLDisplay display;
+        display = EGL_NO_DISPLAY;
+        for (i = 0; i < sizeof(candidates) / sizeof(candidates[0]); i++) {
+            SDL_memset(&ps4_pgl_config, 0, sizeof(ps4_pgl_config));
+            ps4_pgl_config.size = sizeof(ps4_pgl_config);
+            ps4_pgl_config.flags = ORBIS_PGL_FLAGS_USE_COMPOSITE_EXT | 0x60;
+            if (candidates[i].flexible != 0) {
+                ps4_pgl_config.flags |= ORBIS_PGL_FLAGS_USE_FLEXIBLE_MEMORY;
+            }
+            ps4_pgl_config.processOrder = 1;
+            ps4_pgl_config.systemSharedMemorySize = candidates[i].systemShared;
+            ps4_pgl_config.videoSharedMemorySize = candidates[i].videoShared;
+            ps4_pgl_config.maxMappedFlexibleMemory = candidates[i].flexible;
+            ps4_pgl_config.drawCommandBufferSize = candidates[i].drawCommandBuffer;
+            ps4_pgl_config.lcueResourceBufferSize = candidates[i].lcueResourceBuffer;
+            ps4_pgl_config.dbgPosCmd_0x40 = 1920;
+            ps4_pgl_config.dbgPosCmd_0x44 = 1080;
+            ps4_pgl_config.unk_0x5C = 2;
+
+            if (!scePigletSetConfigurationVSH(&ps4_pgl_config)) {
+                SDL_Log("PS4_PigletInit: scePigletSetConfigurationVSH rejected config %zu\n", i);
+                continue;
+            }
+            display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+            if (display != EGL_NO_DISPLAY) {
+                SDL_Log("PS4_PigletInit: eglGetDisplay ok with config %zu\n", i);
+                break;
+            }
+            SDL_Log("PS4_PigletInit: eglGetDisplay failed with config %zu\n", i);
+        }
+        if (display == EGL_NO_DISPLAY) {
+            SDL_Log("PS4_PigletInit: eglGetDisplay failed with every Piglet configuration\n");
+            return 1;
+        }
     }
 
     SDL_Log("PS4_PigletInit: Ok\n");
