diff --git a/src/app/ps4_diag_log.h b/src/app/ps4_diag_log.h
new file mode 100644
index 0000000..cbac782
--- /dev/null
+++ b/src/app/ps4_diag_log.h
@@ -0,0 +1,29 @@
+// Aseprite    - Copyright (C) 2001-2016  David Capello
+// LibreSprite - Copyright (C) 2018-2026  LibreSprite contributors
+//
+// This program is free software; you can redistribute it and/or modify
+// it under the terms of the GNU General Public License version 2 as
+// published by the Free Software Foundation.
+
+// PS4 diagnostic startup log (TEMPORARY, for the black-screen diagnosis).
+// Writes one flushed line per checkpoint to /data/libresprite.log on the
+// console, so a console test shows exactly where the editor stops during
+// startup. Each call opens/appends/closes the file, so no FILE* is shared
+// between translation units and no log-level or she::log setup is needed.
+// Remove this file and all ps4_diag() calls once the startup hang is fixed.
+#pragma once
+
+#include <cstdio>
+#include <string>
+
+// Takes std::string so call sites can build messages dynamically
+// (e.g. with a module name or a value); string literals convert
+// implicitly, so plain ps4_diag("text") keeps working.
+inline void ps4_diag(const std::string& msg)
+{
+  FILE* f = std::fopen("/data/libresprite.log", "a");
+  if (f) {
+    std::fprintf(f, "[diag] %s\n", msg.c_str());
+    std::fclose(f);
+  }
+}
